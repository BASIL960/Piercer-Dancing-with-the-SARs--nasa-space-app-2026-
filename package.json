{
  "name": "piercer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Piercer — a 3D documentary of three 2026 events NISAR radar saw through cloud, smoke and storms: a Himalayan glacier flood, an Oregon–Idaho megafire and Jazan's rainy season. NASA Space Apps 2026, Dancing with the SARs.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "data:research": "node scripts/stories/fetch-research.mjs",
    "data:globe": "node scripts/stories/globe.mjs",
    "data:build": "node scripts/stories/build.mjs",
    "data:verify": "node scripts/stories/check-georef.mjs && node scripts/stories/verify.mjs",
    "data": "npm run data:research && npm run data:globe && npm run data:build && npm run data:verify",
    "check": "node scripts/check-journey.mjs"
  },
  "dependencies": {
    "@fontsource-variable/readex-pro": "^5.3.0",
    "@fontsource-variable/reem-kufi": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "geotiff": "^2.1.3",
    "playwright-core": "^1.65.0",
    "proj4": "^2.15.0",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
